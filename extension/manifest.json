{
  "manifest_version": 3,
  "name": "IDM Lite Integration Module",
  "version": "1.0.8",
  "description": "Chuyển tiếp mọi lượt tải xuống & bắt link mọi video trên trình duyệt sang IDM Lite (Developed by HuyTran1002)",
  "permissions": [
    "downloads",
    "downloads.shelf",
    "cookies",
    "webRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:9091/*",
    "http://localhost:9091/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM Lite - Bắt link & Tải Video"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
